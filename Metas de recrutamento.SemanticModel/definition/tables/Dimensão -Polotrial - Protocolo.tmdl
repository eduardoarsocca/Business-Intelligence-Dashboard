	column 'Status do estudo (grupos)' =
			SWITCH(
				TRUE,
				ISBLANK('Dimensão -Polotrial - Protocolo'[Status do estudo]),
				"(Em branco)",
				'Dimensão -Polotrial - Protocolo'[Status do estudo] IN {"Em Andamento"},
				"ACADEMY",
				'Dimensão -Polotrial - Protocolo'[Status do estudo] IN {"Cancelado",
					"Cancelado - Orçamento não aprovado pelo patrocinador",
					"Cancelado - Patrocinador",
					"Cancelado - Solicitação Investigador",
					"Cancelado pelo patrocinador",
					"Feasibility cancelado pelo patrocinador"},
				"CANCELADOS",
				'Dimensão -Polotrial - Protocolo'[Status do estudo] IN {"Feasibility - declinado pela SVRI",
					"Feasibility declinado pelo centro de pesquisa",
					"Feasibility declinado pelo Investigador",
					"Prospecção declinada pela SVRI",
					"Prospecção declinada pelo centro de pesquisa",
					"Prospecção declinada pelo Investigador",
					"Prospecção declinada pelo patrocinador"},
				"DECLINADOS",
				'Dimensão -Polotrial - Protocolo'[Status do estudo] IN {"Cadastro Financeiro"},
				"FINANCEIRO",
				'Dimensão -Polotrial - Protocolo'[Status do estudo] IN {"MATERIAIS"},
				"MATERIAIS",
				'Dimensão -Polotrial - Protocolo'[Status do estudo] IN {"Feasibility centro não selecionado"},
				"NÃO SELECIONADO",
				'Dimensão -Polotrial - Protocolo'[Status do estudo]
			)
		lineageTag: 8c12e7a6-4555-4df7-a1d6-ac9dea629a37
		summarizeBy: none

