	partition 'Dimensão -Polotrial - Protocolo-5eaee938-c694-4dd5-88a3-1869f74ca7f6' = m
		mode: import
		queryGroup: 'Polotrial - Protocolo'
		source = ```
				let
				    Body = "{
				                ""nome"": """&param_user&""",
				                ""password"": """&param_senha&"""
				    }",
				    getToken = Json.Document(
				       Web.Contents(
				           param_api &"/sessions", [
				               Headers = 
				               [#"Content-Type"="application/json"],
				               Content=Text.ToBinary(Body)
				           ]
				       )
				    ),
				    Token= getToken[token],
				    AuthToken = "Bearer " & Token,
				    urlRequest = param_api &"/protocolo?nested=true",
				    results = Json.Document(
				        Web.Contents(
				            urlRequest,
				            [Headers = [Authorization=AuthToken]]
				        )
