	measure VARIAÇÃO_PERCENTUAL_FEASI =
			
			IF(
			    ISBLANK([protocoloscadastrados2023]) || [protocoloscadastrados2023] = 0,
			    BLANK(),
			    ([protocoloscadastrados2024] - [protocoloscadastrados2023]) / [protocoloscadastrados2023]
			)+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: db07bbfd-bab4-46ae-a7fe-46ed04a38408

	measure conversao2023 = ```
			
			var cadastro2023 = CALCULATE(
			    DISTINCTCOUNT('Dimensão -Polotrial - Protocolo'[id]), 
			    FILTER(
			        'Dimensão -Polotrial - Protocolo', 
			        'Dimensão -Polotrial - Protocolo'[Data: cadastro do protocolo] >= DATE(2022, 3, 1) && 
			        'Dimensão -Polotrial - Protocolo'[Data: cadastro do protocolo] < DATE(2023, 3, 1)
			    ), 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"DECLINADOS" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<> "CANCELADOS" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<> "ACADEMY" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<> "FINANCEIRO" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"MATERIAIS" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"NÃO SELECIONADO"
			)
			
			var convertidos2023 = CALCULATE(
			    DISTINCTCOUNT('Dimensão -Polotrial - Protocolo'[id]), 
			    FILTER(
			        'Dimensão -Polotrial - Protocolo', 
			        'Dimensão -Polotrial - Protocolo'[Data: cadastro do protocolo] >= DATE(2022, 3, 1) && 
			        'Dimensão -Polotrial - Protocolo'[Data: cadastro do protocolo] < DATE(2023, 3, 1)
			    ), 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"DECLINADOS" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<> "CANCELADOS" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<> "ACADEMY" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<> "FINANCEIRO" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"MATERIAIS" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"NÃO SELECIONADO" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"Centro backup" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"Em qualificação" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"Estudo em On hold" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"Feasibility" && 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"Prospecção de estudo"&& 'Dimensão -Polotrial - Protocolo'[Status do estudo (grupos)]<>"Protocolo adiado"
			)
			
			
			
			return DIVIDE(convertidos2023, cadastro2023, 0) 
			```
