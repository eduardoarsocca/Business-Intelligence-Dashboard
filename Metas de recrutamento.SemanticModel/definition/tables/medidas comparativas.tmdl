table 'medidas comparativas'
	lineageTag: 72df9554-7ae4-4f33-9aef-b4ec055638a2

	measure protocolos = DISTINCTCOUNT('Dimensão -Polotrial - Protocolo'[id])
		formatString: 0
		lineageTag: 4dc13887-a1f4-4179-a02d-84bca64e6792

	measure VARIAÇÃO_PERCENTUAL_REC =
			
			IF(
			    ISBLANK([rec2023]) || [rec2023] = 0,
			    BLANK(),
			    ([rec2024] - [rec2023]) / [rec2023]
			)+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5d0ab060-a9c8-43e9-9086-de7c6c20aefd

	measure rec2023 = ```
			
			CALCULATE(
			    DISTINCTCOUNT('Fato - Polotrial - Participantes'[id]), 
			    FILTER(
			        Calendario, 
			        Calendario[Date] >= DATE(2022, 3, 1) && 
			        Calendario[Date] < DATE(2023, 3, 1)
			    )
			)
			
			```
		formatString: 0
		lineageTag: fbb244c9-e4c9-4455-8d3d-0f52aab422c9

	measure rec2024 = ```
			
			CALCULATE(
			    DISTINCTCOUNT('Fato - Polotrial - Participantes'[id]), 
			    FILTER(
			        Calendario, 
			        Calendario[Date] >= DATE(2023, 3, 1) && 
			        Calendario[Date] < DATE(2024, 3, 1)
			    )
			)
			```
		formatString: 0
		lineageTag: 1399099c-226d-4126-a3a5-9f2453268fbc

	measure protocoloscadastrados2023 = ```
			
			CALCULATE(
			    DISTINCTCOUNT('Dimensão -Polotrial - Protocolo'[id]), 
			    FILTER(
			        'Dimensão -Polotrial - Protocolo', 
			        'Dimensão -Polotrial - Protocolo'[Data: cadastro do protocolo] >= DATE(2022, 3, 1) && 
			        'Dimensão -Polotrial - Protocolo'[Data: cadastro do protocolo] < DATE(2023, 3, 1)
			    )
			)
			```
		formatString: 0
		lineageTag: 93fb8981-511d-4e62-90b6-64ccbf539d6f

	measure protocoloscadastrados2024 = ```
			
			CALCULATE(
